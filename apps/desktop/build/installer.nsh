; Removing the app takes its start with Windows along. An update reinstalls over itself and keeps it.
!macro customUnInstall
  ${ifNot} ${isUpdated}
    DeleteRegValue HKCU "Software\Microsoft\Windows\CurrentVersion\Run" "LiveChatSBCB"
    DeleteRegValue HKCU "Software\Microsoft\Windows\CurrentVersion\Explorer\StartupApproved\Run" "LiveChatSBCB"
    DeleteRegKey HKCU "Software\Classes\*\shell\LiveChatSBCB.Prepare"
    DeleteRegKey HKCU "Software\Classes\*\shell\LiveChatSBCB.Send"
    ; One entry by kind of file, as the app writes them.
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.png\shell\LiveChatSBCB.Prepare"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.png\shell\LiveChatSBCB.Send"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.jpg\shell\LiveChatSBCB.Prepare"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.jpg\shell\LiveChatSBCB.Send"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.jpeg\shell\LiveChatSBCB.Prepare"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.jpeg\shell\LiveChatSBCB.Send"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.gif\shell\LiveChatSBCB.Prepare"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.gif\shell\LiveChatSBCB.Send"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.webp\shell\LiveChatSBCB.Prepare"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.webp\shell\LiveChatSBCB.Send"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mp4\shell\LiveChatSBCB.Prepare"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mp4\shell\LiveChatSBCB.Send"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.m4v\shell\LiveChatSBCB.Prepare"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.m4v\shell\LiveChatSBCB.Send"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mov\shell\LiveChatSBCB.Prepare"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mov\shell\LiveChatSBCB.Send"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.webm\shell\LiveChatSBCB.Prepare"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.webm\shell\LiveChatSBCB.Send"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mp3\shell\LiveChatSBCB.Prepare"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mp3\shell\LiveChatSBCB.Send"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.ogg\shell\LiveChatSBCB.Prepare"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.ogg\shell\LiveChatSBCB.Send"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.opus\shell\LiveChatSBCB.Prepare"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.opus\shell\LiveChatSBCB.Send"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.wav\shell\LiveChatSBCB.Prepare"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.wav\shell\LiveChatSBCB.Send"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.m4a\shell\LiveChatSBCB.Prepare"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.m4a\shell\LiveChatSBCB.Send"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.flac\shell\LiveChatSBCB.Prepare"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.flac\shell\LiveChatSBCB.Send"
  ${endIf}
!macroend
