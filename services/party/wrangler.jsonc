{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "livechatsbcb-party",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "PARTY", "class_name": "Party" }
    ]
  },
  "r2_buckets": [
    { "binding": "UPDATES", "bucket_name": "livechatsbcb-updates" },
    { "binding": "MEDIA", "bucket_name": "livechatsbcb-media" }
  ],
  "vars": { "MEDIA_RETENTION_MS": "86400000" },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Directory", "Party"] }]
}
